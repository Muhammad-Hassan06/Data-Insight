# OpenAQ API v3 Key (Register at openaq.org for free tier key)
OPENAQ_API_KEY=your_openaq_api_key_here

# Open-Meteo does not require an API key for standard non-commercial usage
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Optional: NASA FIRMS Map Key (if using fire hotspots enrichment)
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

# Hugging Face token (for publishing spaces or downloading models)
HF_TOKEN=your_hf_token_here
